# Pilot server settings: cp .env.pilot.example .env.pilot, fill EVERY empty value, never commit .env.pilot.
# docker compose --env-file .env.pilot -f docker-compose.pilot.yml up -d --build
# Generate each secret on the server:  openssl rand -base64 32

# Public host name (its DNS A/AAAA record must already point at this server: Caddy gets the HTTPS certificate for it)
PILOT_DOMAIN=
# E-mail domain of the generated pilot accounts (gv01@<domain> ...); real addresses: use --emails-file instead
PILOT_EMAIL_DOMAIN=

# Database owner (migrations, seed) and the least-privilege runtime login ulp_api (what the services use)
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=

# Signs sessions and tokens; changing it signs everybody out. >= 32 random characters
SECRET_KEY=
# KEK master key of personal data (KEY_SERVICE_BACKEND=env). KEEP A COPY OFF THIS SERVER: lose it and the encrypted
# profiles of users enrolled through the API cannot be read again. base64 of 32 random bytes
PII_MASTER_KEY=

# AI import (Google AI Studio keys; several keys rotate). Models were checked against what the keys can use.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
GEMINI_EXTRACT_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_EXTRACT_THINKING=low
# Fallbacks when Gemini is out of quota (optional)
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_DAILY_LIMITS=gemini:55,groq:900,openrouter:45
AI_BATCH_SIZES=gemini:15,groq:6,openrouter:8
