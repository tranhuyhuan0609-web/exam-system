# Copy to .env and adjust as needed
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://exam:exam@localhost:5432/exam
SECRET_KEY=change-me

# AI import (Google AI Studio key). Models are tried in order when one is overloaded.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.6-flash
# Reading exam pages: cheaper models first (free quotas are per model), with little thinking
GEMINI_EXTRACT_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash
GEMINI_EXTRACT_THINKING=low
# Uploads, rendered pages and question figures
DATA_DIR=data

# Storage: "local" (files under DATA_DIR/media) or "s3" (docker compose up -d s3, or MinIO / AWS S3 / R2)
STORAGE_BACKEND=local
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_PUBLIC_URL=http://localhost:9000

# Question crawler: docker compose up -d kafka mongo
KAFKA_BOOTSTRAP=localhost:9092
MONGO_URL=mongodb://localhost:27017
# AI fallbacks for crawled questions when Gemini is out of quota (free keys: console.groq.com, openrouter.ai)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# Text models tried in order (":free" ones cost nothing; enable free endpoints in OpenRouter privacy settings)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Image-reading models tried before Gemini for exam pages and figures
OPENROUTER_VISION_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
AI_DAILY_LIMITS=gemini:55,groq:900,openrouter:45
AI_BATCH_SIZES=gemini:15,groq:6,openrouter:8
# Library: public Google Drive folders (configs/drive/*.yaml)
GOOGLE_DRIVE_API_KEY=
# Tesseract language data folder with vie.traineddata: OCR of scanned library PDFs (empty = off)
TESSDATA_DIR=
