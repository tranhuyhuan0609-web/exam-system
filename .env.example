# Copy to .env and adjust as needed
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://exam:exam@localhost:5432/exam
# Through PgBouncer as the least-privilege login (what docker compose runs):
# DATABASE_URL=postgresql+asyncpg://ulp_api:ulp_api_dev@localhost:6432/exam
# DB_PGBOUNCER=true
# Password of the runtime login ulp_api (python -m app.platform.runtime_login)
RUNTIME_DB_PASSWORD=ulp_api_dev

# V11.3 infrastructure: docker compose up -d pgbouncer redis vault clamav
REDIS_URL=redis://localhost:6379/0
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SECRET_KEY=change-me

# AI import (Google AI Studio key). Models are tried in order when one is overloaded.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.6-flash
# Reading exam pages: cheaper models first (free quotas are per model), with little thinking
GEMINI_EXTRACT_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash
GEMINI_EXTRACT_THINKING=low
# Uploads, rendered pages and question figures
DATA_DIR=data

# Storage: "local" (files under DATA_DIR/media) or "s3" (docker compose up -d s3, or MinIO / AWS S3 / R2)
STORAGE_BACKEND=local
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_PUBLIC_URL=http://localhost:9000

# Question crawler: docker compose up -d kafka mongo
KAFKA_BOOTSTRAP=localhost:9092
MONGO_URL=mongodb://localhost:27017
# AI fallbacks for crawled questions when Gemini is out of quota (free keys: console.groq.com, openrouter.ai)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# Text models tried in order (":free" ones cost nothing; enable free endpoints in OpenRouter privacy settings)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Image-reading models tried before Gemini for exam pages and figures (off: free ones misread scans), e.g.
# google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
OPENROUTER_VISION_MODELS=
AI_DAILY_LIMITS=gemini:55,groq:900,openrouter:45
AI_BATCH_SIZES=gemini:15,groq:6,openrouter:8
# Library: public Google Drive folders (configs/drive/*.yaml)
GOOGLE_DRIVE_API_KEY=
# Tesseract language data folder with vie.traineddata: OCR of scanned library PDFs (empty = off)
TESSDATA_DIR=

# More OpenAI-compatible AI providers, declared here without code (tried after Groq / OpenRouter for text,
# before the free ones for reading images). Azure for Students (GitHub Student Pack: $100 credit / 12 months):
# AI_PROVIDERS=azure
# AZURE_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# AZURE_API_KEY=
# AZURE_MODELS=gpt-4o-mini
# AZURE_VISION_MODELS=gpt-4o-mini
# AZURE_AUTH=api-key
# Budget per day: add it to AI_DAILY_LIMITS, e.g. AI_DAILY_LIMITS=gemini:55,groq:900,openrouter:45,azure:2000
#
# Free tiers with a built-in preset (app/config.py PRESETS): list the name and set its key, nothing else.
#   mistral     https://console.mistral.ai          (free "Experiment" plan, no card)  MISTRAL_API_KEY
#   cerebras    https://cloud.cerebras.ai                                              CEREBRAS_API_KEY
#   sambanova   https://cloud.sambanova.ai                                             SAMBANOVA_API_KEY
#   nvidia      https://build.nvidia.com            (free credits)                     NVIDIA_API_KEY
#   cohere      https://dashboard.cohere.com        (trial key)                        COHERE_API_KEY
#   huggingface https://huggingface.co/settings/tokens (monthly free credits)          HUGGINGFACE_API_KEY
#   cloudflare  https://dash.cloudflare.com (Workers AI) CLOUDFLARE_API_KEY + CLOUDFLARE_ACCOUNT_ID
# e.g. AI_PROVIDERS=mistral,cerebras,sambanova — then `python -m app.ai.check` tests each key and model;
# <NAME>_MODELS overrides the preset's models (`python -m app.ai.check --all` lists the names).
AI_PROVIDERS=

# Open sources harvested into the library (python -m app.pipeline.harvest, plan: configs/open_sources.yaml).
# All optional. OpenAlex without a key shares ~1000 requests a day per IP; a free key (openalex.org/settings/api)
# has its own budget. Semantic Scholar: api.semanticscholar.org (key on request). Crossref: a contact address.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
