# Copy to .env and adjust as needed
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://exam:exam@localhost:5432/exam
SECRET_KEY=change-me

# AI import (Google AI Studio key). Models are tried in order when one is overloaded.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.6-flash
# Uploads, rendered pages and question figures
DATA_DIR=data

# Storage: "local" (files under DATA_DIR/media) or "s3" (docker compose up -d s3, or MinIO / AWS S3 / R2)
STORAGE_BACKEND=local
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_PUBLIC_URL=http://localhost:9000
